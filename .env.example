# Copy to .env and fill in values. Never commit .env.

# --- LLM (required for SQL generation and answer synthesis) -----------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=          # optional: Azure/OpenAI-compatible gateway
OPENAI_TIMEOUT_S=30
OPENAI_MAX_RETRIES=2

# --- Retrieval ---------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ENABLE_RERANKER=true
CHROMA_PATH=./storage/chroma
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATES=20
MIN_RERANK_SCORE=-3.0

# --- PostgreSQL ----------------------------------------------------------------
# The agent connects as a SELECT-only role. The admin URL is used only by scripts/seed_db.py.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-admin
POSTGRES_DB=retail
READONLY_DB_USER=agent_readonly
READONLY_DB_PASSWORD=change-me-readonly
DATABASE_URL=postgresql://agent_readonly:change-me-readonly@localhost:5432/retail
DATABASE_ADMIN_URL=postgresql://postgres:change-me-admin@localhost:5432/retail
SQL_ROW_LIMIT=200
SQL_STATEMENT_TIMEOUT_MS=5000

# --- Observability (optional) --------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

LOG_LEVEL=INFO
